# Gmail SMTP (used for all transactional emails — booking requests, confirmations, reminders)
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Admin credentials
ADMIN_EMAIL=admin@bienbonita.com
ADMIN_PASSWORD=changeme123

# Secret for signing admin session tokens
ADMIN_SECRET=change-this-to-a-random-string

# Secret for signing customer session tokens
CUSTOMER_SECRET=change-this-to-a-random-string

# Google OAuth for customer sign-in (Google Cloud Console → Credentials → OAuth client ID)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# EmailJS is no longer used — all emails now send via Gmail SMTP (GMAIL_USER / GMAIL_APP_PASSWORD above)
